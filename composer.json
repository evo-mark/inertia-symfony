{
    "name": "evo-mark/inertia-symfony",
    "description": "Inertia.js adapter for Symfony",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": [
        "inertia",
        "inertiajs",
        "symfony",
        "bundle",
        "ssr",
        "server-side-rendering",
        "spa",
        "vue",
        "react",
        "svelte"
    ],
    "homepage": "https://evo-mark.github.io/inertia-symfony/",
    "authors": [
        {
            "name": "evoMark",
            "homepage": "https://evomark.co.uk"
        }
    ],
    "support": {
        "issues": "https://github.com/evo-mark/inertia-symfony/issues",
        "source": "https://github.com/evo-mark/inertia-symfony",
        "docs": "https://evo-mark.github.io/inertia-symfony/"
    },
    "scripts": {
        "cs:check": [
            "./vendor/bin/php-cs-fixer check"
        ],
        "cs:fix": [
            "./vendor/bin/php-cs-fixer fix"
        ],
        "test": [
            "./vendor/bin/phpunit"
        ]
    },
    "require": {
        "php": ">=8.4",
        "ext-curl": "*",
        "ext-json": "*",
        "symfony/clock": "^8.1",
        "symfony/console": "^8.1.5",
        "symfony/dependency-injection": "^8.1",
        "symfony/filesystem": "^8.1",
        "symfony/framework-bundle": "^8.1",
        "symfony/http-client": "^8.1",
        "symfony/http-foundation": "^8.1",
        "symfony/http-kernel": "^8.1",
        "symfony/process": "^8.1",
        "symfony/twig-bundle": "^8.1",
        "twig/twig": "^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpunit/phpunit": "^13.0",
        "symfony/browser-kit": "^8.1",
        "symfony/mime": "^8.1",
        "symfony/serializer": "^8.1",
        "symfony/validator": "^8.1",
        "symfony/error-handler": "^8.1.5"
    },
    "suggest": {
        "symfony/validator": "Send #[MapRequestPayload] validation errors back to Inertia forms"
    },
    "autoload": {
        "psr-4": {
            "EvoMark\\InertiaSymfonyBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EvoMark\\InertiaSymfonyBundle\\Tests\\": "tests/"
        }
    }
}
