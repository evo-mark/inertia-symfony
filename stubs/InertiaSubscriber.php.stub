<?php

namespace {{ namespace }};

use EvoMark\InertiaSymfonyBundle\Interfaces\InertiaInterface;
use Symfony\Component\EventDispatcher\Attribute\AsEventListener;
use Symfony\Component\HttpKernel\Event\ControllerEvent;

/**
 * Shares props with every Inertia page.
 */
#[AsEventListener]
final class {{ class }}
{
    public function __construct(private InertiaInterface $inertia)
    {
    }

    public function __invoke(ControllerEvent $event): void
    {
        if (!$event->isMainRequest()) {
            return;
        }

        $this->inertia->share('auth.user', [
            'name' => 'Hannes', // Resolved now
            'posts' => fn () => [1 => 'Post'], // Resolved lazily, only when the prop is sent
        ]);
    }
}
